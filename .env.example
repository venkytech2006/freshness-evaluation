# FreshGuard environment configuration — template
# Copy this file to `.env` and fill in the keys you have. All keys are optional;
# with everything blank FreshGuard runs fully offline from the seeded knowledge base.

# --- Live knowledge ingestion (used when a query is NOT in the knowledge base) ---

# Tavily web search — https://tavily.com
TAVILY_API_KEY=

# xAI Grok — https://console.x.ai  (XAI_API_KEY preferred; GROK_API_KEY also accepted)
XAI_API_KEY=
# GROK_API_KEY=

# --- Optional: route answer GENERATION through a hosted LLM (Admin > LLM provider) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
